<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LiftLife.Views.SplashPage"
             BackgroundColor="{StaticResource AppBackground}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*, Auto, *" Padding="24">

        <!-- Center brand block -->
        <VerticalStackLayout Grid.Row="1" Spacing="14" HorizontalOptions="Center" VerticalOptions="Center">

            <!-- Logo: same artwork as the app icon (Resources/Images/logo.svg) -->
            <Image Source="logo.png"
                   HeightRequest="96" WidthRequest="96"
                   HorizontalOptions="Center"
                   SemanticProperties.Description="LiftLife logo" />

            <Label Text="LiftLife"
                   FontSize="34"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}"
                   HorizontalOptions="Center" />

            <Label Text="Community Gym Hub"
                   FontSize="15"
                   TextColor="{StaticResource Primary}"
                   HorizontalOptions="Center" />

            <ActivityIndicator IsRunning="True"
                               Color="{StaticResource Primary}"
                               HeightRequest="26"
                               Margin="0,8,0,0" />
        </VerticalStackLayout>

        <!-- Footer slogan -->
        <Label Grid.Row="2"
               Text="Smart Community &amp; Digital Innovation"
               FontSize="12"
               FontAttributes="Italic"
               TextColor="{StaticResource Primary}"
               HorizontalOptions="Center"
               VerticalOptions="End"
               Margin="0,0,0,24" />
    </Grid>
</ContentPage>
