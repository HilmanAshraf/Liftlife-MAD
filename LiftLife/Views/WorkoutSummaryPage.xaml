<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:LiftLife.Models"
             x:Class="LiftLife.Views.WorkoutSummaryPage"
             x:DataType="models:WorkoutSummary"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource AppBackground}">

    <ContentPage.Resources>
        <Style x:Key="StatValue" TargetType="Label">
            <Setter Property="TextColor" Value="{StaticResource Primary}" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="20,20,20,20" Spacing="14">

                <Label Text="WORKOUT COMPLETE" Style="{StaticResource MutedCaption}" HorizontalOptions="Center" Margin="0,10,0,0" />
                <Label Text="{Binding RoutineName}" Style="{StaticResource ScreenTitle}" HorizontalOptions="Center" />
                <Label Text="{Binding DateText}" Style="{StaticResource SubtleText}" HorizontalOptions="Center" />

                <!-- Session stats -->
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12" Margin="0,6,0,0">
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="TOTAL VOLUME" Style="{StaticResource MutedCaption}" />
                            <Label Text="{Binding VolumeText}" Style="{StaticResource StatValue}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="DURATION" Style="{StaticResource MutedCaption}" />
                            <Label Text="{Binding DurationText}" Style="{StaticResource StatValue}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="SETS DONE" Style="{StaticResource MutedCaption}" />
                            <Label Text="{Binding SetsText}" Style="{StaticResource StatValue}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="EXERCISES" Style="{StaticResource MutedCaption}" />
                            <Label Text="{Binding ExercisesText}" Style="{StaticResource StatValue}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Dynamic macro trigger -->
                <Border Style="{StaticResource CardElevated}" Stroke="{StaticResource Primary}">
                    <VerticalStackLayout Spacing="8">
                        <Border BackgroundColor="{StaticResource Primary}" StrokeThickness="0"
                                Padding="12,5" HorizontalOptions="Start">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Label Text="⚡ TRAINING DAY" FontSize="12" FontAttributes="Bold"
                                   TextColor="{StaticResource PrimaryDarkText}" />
                        </Border>
                        <Label Text="{Binding Macros.HeadlineText}" Style="{StaticResource CardTitle}" />
                        <Label Text="{Binding Macros.CaloriesText}" Style="{StaticResource BodyText}" />
                        <Label Text="{Binding Macros.CarbsText}" Style="{StaticResource BodyText}" />
                        <Label Text="Your Nutrition targets have been raised to fuel recovery."
                               Style="{StaticResource SubtleText}" FontSize="12" />
                    </VerticalStackLayout>
                </Border>

                <!-- Per-exercise results -->
                <Grid ColumnDefinitions="*,Auto" Margin="4,6,4,0">
                    <Label Text="EXERCISES" Style="{StaticResource MutedCaption}" />
                    <Label Grid.Column="1" Text="{Binding PrText}" Style="{StaticResource MutedCaption}"
                           TextColor="{StaticResource Primary}" />
                </Grid>

                <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Results}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:ExerciseResult">
                            <Border Style="{StaticResource Card}" Padding="16,12">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Name}" Style="{StaticResource CardTitle}" FontSize="15" />
                                        <Label Text="{Binding DetailText}" Style="{StaticResource SubtleText}" FontSize="12" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="1" IsVisible="{Binding IsNewPr}"
                                            BackgroundColor="{StaticResource StatusFree}" StrokeThickness="0"
                                            Padding="10,4" VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>
                                        <Label Text="NEW PR" FontSize="11" FontAttributes="Bold"
                                               TextColor="{StaticResource PrimaryDarkText}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Button Grid.Row="1" Text="DONE" Style="{StaticResource PrimaryButton}"
                Margin="20,8,20,30" Clicked="OnDoneClicked" />
    </Grid>
</ContentPage>
