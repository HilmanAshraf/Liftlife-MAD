<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LiftLife.Views.CommunityPage"
             Title="Community"
             BackgroundColor="{StaticResource AppBackground}">

    <Grid RowDefinitions="Auto,*" Padding="20,16">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <Label Text="LiftLife" Style="{StaticResource ScreenTitle}" VerticalOptions="Center" />
            <Label Grid.Column="1" Text="📍 Campus Gym" Style="{StaticResource SubtleText}" VerticalOptions="Center" />
        </Grid>

        <VerticalStackLayout Grid.Row="1" VerticalOptions="Center" Spacing="8">
            <Label Text="Community Station Hub" Style="{StaticResource CardTitle}" HorizontalOptions="Center" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
