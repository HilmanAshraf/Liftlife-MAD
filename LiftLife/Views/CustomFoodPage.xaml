<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             xmlns:vm="clr-namespace:LiftLife.ViewModels"
             x:Class="LiftLife.Views.CustomFoodPage"
             x:DataType="vm:CustomFoodViewModel"
             ios:Page.ModalPresentationStyle="PageSheet"
             BackgroundColor="{StaticResource AppBackground}">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20,24,20,24" RowSpacing="16">

        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
            <Button Text="✕"
                    WidthRequest="40" HeightRequest="40" CornerRadius="20" Padding="0"
                    BackgroundColor="{StaticResource SurfaceElevated}"
                    TextColor="{StaticResource TextPrimary}" FontSize="16"
                    Clicked="OnCloseClicked" />
            <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center">
                <Label Text="Create Custom Food" Style="{StaticResource CardTitle}" HorizontalOptions="Center" />
                <Label Text="Values per one serving" Style="{StaticResource SubtleText}" HorizontalOptions="Center" />
            </VerticalStackLayout>
            <ContentView Grid.Column="2" WidthRequest="40" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="14">
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="FOOD NAME" Style="{StaticResource MutedCaption}" />
                        <Border Style="{StaticResource FieldBox}">
                            <Entry Text="{Binding Name}" Placeholder="e.g. Cafeteria Chicken Rice"
                                   Style="{StaticResource LiftEntry}" MaxLength="40" />
                        </Border>

                        <Label Text="SERVING SIZE" Style="{StaticResource MutedCaption}" />
                        <Border Style="{StaticResource FieldBox}">
                            <Entry Text="{Binding Serving}" Placeholder="e.g. 1 plate, 100 g"
                                   Style="{StaticResource LiftEntry}" MaxLength="20" />
                        </Border>

                        <Label Text="CALORIES (KCAL)" Style="{StaticResource MutedCaption}" />
                        <Border Style="{StaticResource FieldBox}">
                            <Entry Text="{Binding Calories}" Placeholder="e.g. 520" Keyboard="Numeric"
                                   Style="{StaticResource LiftEntry}" MaxLength="4" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="MACROS (GRAMS)" Style="{StaticResource MutedCaption}" />
                        <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="4">
                            <Label Text="PROTEIN" Style="{StaticResource MutedCaption}" TextColor="{StaticResource MacroProtein}" />
                            <Label Grid.Column="1" Text="CARBS" Style="{StaticResource MutedCaption}" TextColor="{StaticResource MacroCarbs}" />
                            <Label Grid.Column="2" Text="FAT" Style="{StaticResource MutedCaption}" TextColor="{StaticResource MacroFat}" />

                            <Border Grid.Row="1" Style="{StaticResource FieldBox}">
                                <Entry Text="{Binding Protein}" Placeholder="0" Keyboard="Numeric" MaxLength="5"
                                       Style="{StaticResource LiftEntry}" HorizontalTextAlignment="Center" />
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBox}">
                                <Entry Text="{Binding Carbs}" Placeholder="0" Keyboard="Numeric" MaxLength="5"
                                       Style="{StaticResource LiftEntry}" HorizontalTextAlignment="Center" />
                            </Border>
                            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource FieldBox}">
                                <Entry Text="{Binding Fat}" Placeholder="0" Keyboard="Numeric" MaxLength="5"
                                       Style="{StaticResource LiftEntry}" HorizontalTextAlignment="Center" />
                            </Border>
                        </Grid>
                        <Label Text="{Binding EstimateText}" Style="{StaticResource SubtleText}" FontSize="12">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsMismatch}" Value="True">
                                    <Setter Property="TextColor" Value="{StaticResource StatusWarning}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Button Grid.Row="2" Text="SAVE FOOD" Style="{StaticResource PrimaryButton}" Clicked="OnSaveClicked" />
    </Grid>
</ContentPage>
