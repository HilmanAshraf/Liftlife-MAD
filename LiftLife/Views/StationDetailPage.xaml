<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LiftLife.ViewModels"
             xmlns:models="clr-namespace:LiftLife.Models"
             xmlns:conv="clr-namespace:LiftLife.Converters"
             x:Class="LiftLife.Views.StationDetailPage"
             x:DataType="vm:StationDetailViewModel"
             Title="Station Log"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource AppBackground}">

    <ContentPage.Resources>
        <conv:StatusToColorConverter x:Key="StatusBg" />
        <conv:StatusToTextColorConverter x:Key="StatusFg" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,40" Spacing="14">

            <!-- Current status -->
            <Border Style="{StaticResource CardElevated}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="{Binding Station.Name}" Style="{StaticResource CardTitle}" FontSize="20" />
                            <Label Text="{Binding TagLine}" Style="{StaticResource SubtleText}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" StrokeThickness="0" Padding="12,5" VerticalOptions="Start"
                                BackgroundColor="{Binding Station.Status, Converter={StaticResource StatusBg}}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Label Text="{Binding Station.StatusLabel}" FontSize="11" FontAttributes="Bold"
                                   TextColor="{Binding Station.Status, Converter={StaticResource StatusFg}}" />
                        </Border>
                    </Grid>
                    <Label Text="{Binding Station.DetailLine}" Style="{StaticResource BodyText}" />
                    <Label Text="{Binding SummaryText}" Style="{StaticResource MutedCaption}" FontSize="12" />
                    <Button Text="Update Status" Style="{StaticResource PrimaryButton}" HeightRequest="46"
                            Margin="0,4,0,0" Clicked="OnUpdateStatusClicked" />
                </VerticalStackLayout>
            </Border>

            <Label Text="MAINTENANCE LOG" Style="{StaticResource MutedCaption}" Margin="4,6,0,0" />

            <!-- Report history, newest first -->
            <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Reports}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:StationReport">
                        <Border Style="{StaticResource Card}" Padding="14,12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <BoxView WidthRequest="12" HeightRequest="12" CornerRadius="6"
                                         BackgroundColor="Transparent" VerticalOptions="Start" Margin="0,4,0,0"
                                         Color="{Binding Status, Converter={StaticResource StatusBg}}" />
                                <VerticalStackLayout Grid.Column="1" Spacing="3">
                                    <Label Text="{Binding HeadlineText}" Style="{StaticResource BodyText}" FontAttributes="Bold" />
                                    <Label Text="{Binding Note}" IsVisible="{Binding HasNote}"
                                           Style="{StaticResource BodyText}" FontSize="13" />
                                    <Label Text="{Binding TimeLine}" Style="{StaticResource SubtleText}" FontSize="12" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
