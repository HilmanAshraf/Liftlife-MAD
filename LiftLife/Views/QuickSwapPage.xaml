<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             xmlns:vm="clr-namespace:LiftLife.ViewModels"
             x:Class="LiftLife.Views.QuickSwapPage"
             x:DataType="vm:QuickSwapViewModel"
             ios:Page.ModalPresentationStyle="PageSheet"
             BackgroundColor="{StaticResource AppBackground}">

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Padding="20,24,20,24" RowSpacing="16">

        <!-- Header: dismiss + title -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
            <Button Text="✕"
                    WidthRequest="40" HeightRequest="40" CornerRadius="20" Padding="0"
                    BackgroundColor="{StaticResource SurfaceElevated}"
                    TextColor="{StaticResource TextPrimary}" FontSize="16"
                    Clicked="OnCloseClicked" />
            <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center">
                <Label Text="Select Immediate Substitute" Style="{StaticResource CardTitle}" HorizontalOptions="Center" />
                <Label x:Name="ReplacingLabel" Style="{StaticResource SubtleText}" HorizontalOptions="Center" />
            </VerticalStackLayout>
            <ContentView Grid.Column="2" WidthRequest="40" />
        </Grid>

        <!-- Biomechanical tag -->
        <Border Grid.Row="1" HorizontalOptions="Center" Padding="14,6"
                BackgroundColor="{StaticResource SurfaceElevated}" StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="14" />
            </Border.StrokeShape>
            <Label Text="{Binding TargetText}" FontSize="13" FontAttributes="Bold"
                   TextColor="{StaticResource Primary}" />
        </Border>

        <!-- Substitute options -->
        <ScrollView Grid.Row="2">
            <VerticalStackLayout Spacing="12">
                <Label Text="No other exercises target this muscle group yet."
                       IsVisible="{Binding IsEmpty}"
                       Style="{StaticResource SubtleText}" HorizontalOptions="Center" Margin="0,30,0,0" />

                <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Choices}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:SwapChoice">
                            <Border Style="{StaticResource Card}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                        <Setter Property="StrokeThickness" Value="2" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnChoiceTapped" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding Name}" Style="{StaticResource CardTitle}" FontSize="16" />
                                        <Label Text="{Binding Detail}" Style="{StaticResource SubtleText}" FontSize="12" />
                                        <Label Text="{Binding AvailabilityText}" FontSize="12" FontAttributes="Bold"
                                               TextColor="{StaticResource StatusWarning}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsFree}" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource StatusFree}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </VerticalStackLayout>
                                    <!-- radio indicator -->
                                    <Ellipse Grid.Column="1" WidthRequest="22" HeightRequest="22"
                                             Stroke="{StaticResource TextMuted}" StrokeThickness="2"
                                             VerticalOptions="Center">
                                        <Ellipse.Triggers>
                                            <DataTrigger TargetType="Ellipse" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource Primary}" />
                                                <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                            </DataTrigger>
                                        </Ellipse.Triggers>
                                    </Ellipse>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Scope selector -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="16,12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                    <Label Text="Update routine permanently" Style="{StaticResource BodyText}" FontAttributes="Bold" />
                    <Label Text="Off = swap for this session only" Style="{StaticResource SubtleText}" FontSize="12" />
                </VerticalStackLayout>
                <Switch Grid.Column="1" IsToggled="{Binding UpdateRoutine}"
                        OnColor="{StaticResource Primary}" ThumbColor="{StaticResource TextPrimary}"
                        VerticalOptions="Center" />
            </Grid>
        </Border>

        <Button Grid.Row="4"
                Text="CONFIRM EXERCISE SWAP"
                Style="{StaticResource PrimaryButton}"
                Clicked="OnConfirmClicked" />
    </Grid>
</ContentPage>
