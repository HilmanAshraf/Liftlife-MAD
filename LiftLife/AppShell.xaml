<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="LiftLife.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:LiftLife.Views"
    Title="LiftLife"
    FlyoutBehavior="Disabled">

    <Shell.Resources>
        <ResourceDictionary>
            <Style TargetType="TabBar" ApplyToDerivedTypes="True">
                <Setter Property="Shell.BackgroundColor" Value="{StaticResource SurfaceCard}" />
                <Setter Property="Shell.ForegroundColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="Shell.TitleColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="Shell.TabBarBackgroundColor" Value="{StaticResource SurfaceCard}" />
                <Setter Property="Shell.TabBarForegroundColor" Value="{StaticResource Primary}" />
                <Setter Property="Shell.TabBarUnselectedColor" Value="{StaticResource TextMuted}" />
                <Setter Property="Shell.TabBarTitleColor" Value="{StaticResource Primary}" />
            </Style>
        </ResourceDictionary>
    </Shell.Resources>

    <TabBar>
        <ShellContent
            Title="Community"
            Icon="tab_community.png"
            ContentTemplate="{DataTemplate views:CommunityPage}"
            Route="community" />

        <ShellContent
            Title="Workouts"
            Icon="tab_workouts.png"
            ContentTemplate="{DataTemplate views:WorkoutsPage}"
            Route="workouts" />

        <ShellContent
            Title="Nutrition"
            Icon="tab_nutrition.png"
            ContentTemplate="{DataTemplate views:NutritionPage}"
            Route="nutrition" />

        <ShellContent
            Title="About"
            Icon="tab_about.png"
            ContentTemplate="{DataTemplate views:AboutPage}"
            Route="about" />
    </TabBar>

</Shell>
